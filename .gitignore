.env
.venv/
node_modules/

# Python cache
__pycache__/
*.py[cod]

# Collector working directories — Comtrade checkpoints, scraped inputs and
# intermediate CSVs. Regenerated by the refresh jobs, never source.
data_collector/fundamental_data/output/
data_collector/market_data/output/
data_collector/news_data/input/
data_collector/news_data/output/

# Dashboard's own disk caches (World Bank indicators, free-Comtrade bilateral
# fallback) — fetched on demand, not source. Lands at repo root when pm2
# runs the dashboard from here rather than dashboard/ directly.
dashboard/cache/
/cache/

# Postgres dumps — the migration seed (scripts/migrate_database.sh) and any
# ad-hoc backups. Real market/news data, sometimes hundreds of MB, and never
# source. Keep them out of git.
backups/
*.dump

# Watchdog notification state — which problems have already been reported.
monitoring/watchdog_state.json

# Output of the cron jobs: health watchdog, minute-bar prune, cache warm-up.
logs/
