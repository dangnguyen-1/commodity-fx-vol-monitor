TV_SESSION_ID=your_session_id
TV_SESSION_SIGN=your_session_sign

COMTRADE_API_KEY_1=your_key1_here
COMTRADE_API_KEY_2=your_key2_here
COMTRADE_API_KEY_3=your_key3_here
COMTRADE_API_KEY_4=your_key4_here
COMTRADE_API_KEY_5=your_key5_here
COMTRADE_API_KEY_6=your_key6_here
COMTRADE_API_KEY_7=your_key7_here

DATABASE_URL=postgresql://localhost:5432/commodities

OPENAI_API_KEY=your_key_here

# Throttles for the news sentiment classifier (news_sentiment.py). These
# were missing here, so a .env copied from this file inherited the code's
# defaults instead — and the default for MAX_ARTICLES_PER_RUN is 0, which
# means *no cap*, not "none". On a database freshly seeded with a backlog
# of unclassified articles that sends the entire backlog through the model
# in a single run, at whatever that costs. Keep a real limit here.
OPENAI_MAX_ARTICLES_PER_RUN=100
OPENAI_MAX_RETRIES=3
OPENAI_MAX_FAILED_ATTEMPTS_PER_ARTICLE=3
OPENAI_SLEEP_SECONDS=1.0